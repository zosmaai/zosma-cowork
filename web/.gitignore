# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/dist-server
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the safe deployment template tracked)
.env*
!.env.example

# deployment secrets (API keys) — never commit
deploy/models.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory