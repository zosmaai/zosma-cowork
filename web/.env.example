# ── Zosma Cowork — per-brand sandbox deployment config ──────────────────────
# Copy to web/.env (gitignored) for each brand instance.
#
# Deploying a new brand = new .env (or a copy of this repo with rebranded
# frontend) + same image + unique port + unique data volume + unique domain.
#
#   docker compose -f docker-compose.sandbox.yml up -d --build

# Container name (default: zosma-cowork)
#CONTAINER_NAME=zosma-cowork

# Host port this brand is exposed on (in-container port is always 30141)
# demo  → 30141
# nandi → 30142
HOST_PORT=30141

# One persistent mount/PVC per brand. Internally it contains home/, rootfs/,
# and state/. The visible /home/user and mutable system share this one PVC.
#   zosma brand → /home/<you>/.zosma-cowork/data
#   nandi brand → /home/<you>/.nandi-cowork/data
# NEVER point this at your personal home or ~/.pi.
# NOTE: .env values are literal — use an absolute path, not ~ or ${...}.
PI_PERSISTENT_DIR=/absolute/path/to/.zosma-cowork/data

# Exact hostnames the browser may use (comma-separated).
# Add your brand's domain + the local fallbacks.
# demo  → PI_WEB_ALLOWED_HOSTS=demo.zosma.ai,localhost
# nandi → PI_WEB_ALLOWED_HOSTS=nandi.zosma.ai,localhost
PI_WEB_ALLOWED_HOSTS=demo.zosma.ai,nandi.zosma.ai,localhost

# HTTP Basic Auth (username is always "pi"). Required if exposed beyond LAN.
#PI_WEB_PASSWORD=

# Container timezone (IANA zone name)
#TZ=UTC

# Optional upstreams (broker / router)
#ZOSMA_AUTH_BASE_URL=
#ZOSMA_ROUTER_BASE_URL=
