# Zosma Cowork docker env. Copy to .env and fill in.

# ── Required (both profiles) ─────────────────────────────────────────
# Shared daemon<->web token. Generate: openssl rand -hex 32
ZOSMA_DAEMON_TOKEN=

# Workspace mounted into the daemon container (host path).
ZOSMA_WORK_DIR=./work
# Host port for the web app.
ZOSMA_WEB_PORT=3000
# Daemon bind host inside the container. Leave 0.0.0.0 for docker (the web
# container reaches it over the compose network; the port is not published).
ZOSMA_DAEMON_HOST=0.0.0.0

# ── Fleet only (docker compose --profile fleet up) ───────────────────
# (single-host default is plain `docker compose up`)
# Full guide: fleet.md (quick start, identity, revocation, k8s path)
# Shared daemons<->control-plane token (may differ from the daemon token).
# The plane refuses to start without it. Generate: openssl rand -hex 32
ZOSMA_CONTROL_PLANE_TOKEN=

# Daemon-side fleet wiring (consumed by the daemon service). All three of
# URL + TOKEN + MACHINE_ID are required to enable fleet; leave the URL empty
# for single-host runs. The id is persisted in the /data volume on first run,
# so changing it later fails startup unless ZOSMA_MACHINE_ID_RESET=1.
ZOSMA_CONTROL_PLANE_URL=
ZOSMA_MACHINE_ID=
ZOSMA_MACHINE_NAME=node-1
# Fleet: ZOSMA_CONTROL_PLANE_URL=ws://control-plane:64714/ws
# Fleet, rotated id: ZOSMA_MACHINE_ID_RESET=1  (unset again after one run)
